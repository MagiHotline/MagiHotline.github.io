// Automatically load all badges from src/assets/badges/
const badgeFiles = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/badges/*.{png,gif,jpg,jpeg,svg,webp,avif}",
  { eager: true }
);

const badges = Object.entries(badgeFiles).map(([path, mod]) => {
  const filename = path.split("/").pop()?.replace(/\.[^/.]+$/, "") || "badge";
  const meta = badgeRegistry[filename] || {
    title: filename.length > 20 ? "Friend / Indie Badge" : filename,
    type: "friend / community",
    desc: "Friend or community button on the matrix.",
    url: ""
  };
  return {
    image: mod.default,
    name: filename,
    title: meta.title,
    type: meta.type,
    desc: meta.desc,
    url: meta.url || null,
  };
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="magi / sh" />
    <title>magi / sh</title>
    <link rel="icon" type="image/svg+xml" href="/icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inconsolata:wght@300;400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <!-- Top Minimal Header -->
    <header class="sh-header">
      <div class="header-inner">
        <a href="/" class="back-link">
          to the hotline
        </a>
      </div>
    </header>

    <!-- Main Container -->
    <main class="sh-container">
      <!-- Title section with Social Icons & Thinking Mascot -->
      <section class="title-section">
        <div class="title-left">
          <h1 class="main-title">magi</h1>
          <div class="social-icons">
            {socials.map((item) => (
              <a
                href={item.url}
                target={item.url.startsWith("http") ? "_blank" : undefined}
                rel="noopener noreferrer"
                class="social-icon-btn"
                title={item.name}
                aria-label={item.name}
              >
                <Fragment set:html={item.svg} />
              </a>
            ))}
          </div>
        </div>
        <div class="title-right">
          <Image
            src={thinkingImg}
            alt="thinking avatar"
            class="thinking-mascot"
            width={90}
            height={90}
          />
        </div>
      </section>

      <!-- About text -->
      <section class="about-section">
        <p class="about-text">
          Haii, I'm Magi (he/him)! I'm a 22 year old student, programmer, writer, logic passionate.
          I use my free time in this world to do what I like most. Most of these things happen to be on the
          infamous internet. This is my own little space. You are welcome! Feel free to wonder.
          [Art on the top right made by my dear friend @shirumidoriiro!]
        </p>
      </section>

      <!-- Old-School Game Cartridges Rack -->
      <section class="cartridges-rack">
        <span class="rack-heading">Select a Cartridge...</span>
        <div class="cartridges-grid">
          {cartridges.map((cart) => (
            <a
              href={cart.url}
              class="cartridge"
              style={`--cart-accent: ${cart.color};`}
            >
              <!-- Top Notch & Grip -->
              <div class="cart-top">
                <div class="cart-grip">
                  <span></span>
                  <span></span>
                  <span></span>
                </div>
                <span class="cart-arrow">&blacktriangledown;</span>
                <span class="cart-code">{cart.code}</span>
              </div>

              <!-- Recessed Label / Sticker -->
              <div class="cart-label">
                <div class="label-header">
                  <span class="label-title">{cart.title}</span>
                  <span class="label-sub">{cart.sub}</span>
                </div>
                <div class="label-desc-wrap">
                  <p class="label-desc">{cart.desc}</p>
                </div>
                <div class="label-footer">
                  <span class="insert-hint">INSERT &rarr;</span>
                </div>
              </div>
            </a>
          ))}
        </div>
      </section>

      <!-- 88x31 Badge Matrix with Minimalist Black Pager on the bottom -->
      {badges.length > 0 && (
        <section class="badge-matrix-section">
          <div class="section-tag">88x31 matrix</div>
          <div class="matrix-grid">
            {badges.map((b) => (
              <a
                href={b.url || undefined}
                target={b.url ? "_blank" : undefined}
                rel={b.url ? "noopener noreferrer" : undefined}
                class={`badge-link ${b.url ? "badge-clickable" : "badge-static"}`}
                data-badge="true"
                data-name={b.name}
                data-title={b.title}
                data-type={b.type}
                data-desc={b.desc}
                data-img-src={b.image.src}
                data-url={b.url || ""}
                title={`${b.title} [${b.type}]`}
              >
                <Image
                  src={b.image}
                  alt={b.name}
                  width={88}
                  height={31}
                  class="badge-img"
                  loading="lazy"
                />
              </a>
            ))}
          </div>

          <!-- Text-Only Picker Toggle directly beneath matrix -->
          <div class="picker-control-bar">
            <button
              type="button"
              id="pager-picker-btn"
              class="picker-toggle-btn"
              aria-pressed="false"
              title="Toggle 88x31 Pager Inspector"
            >
              <span class="picker-btn-text">
                &gt; 88x31 details: <strong id="picker-status-text">disabled</strong>
              </span>
            </button>
          </div>

          <!-- Single Green Box on the bottom -->
          <div class="pager-green-box" id="pager-lcd-screen">
            <div class="pager-screen-content" id="pager-screen-body">
              <div class="pager-box-standby">
                <div class="pager-box-status">&#9632; [88x31 details disabled]</div>
              </div>
            </div>
          </div>
        </section>
      )}

      <!-- Minimal footer -->
      <footer class="sh-footer">
        <span>magi &copy; 2026</span>
        <span>&bull;</span>
        <a href="/">return to main hotline</a>
      </footer>
    </main>

    <!-- Client Script for Pager Inspector -->
    <script is:inline>
      const pickerBtn = document.getElementById("pager-picker-btn");
      const statusText = document.getElementById("picker-status-text");
      const lcdScreen = document.getElementById("pager-lcd-screen");
      const screenBody = document.getElementById("pager-screen-body");
      const badges = document.querySelectorAll(".matrix-grid [data-badge]");

      let detailsEnabled = false;

      function renderPagerScreen(html) {
        if (screenBody) {
          screenBody.innerHTML = html;
        }
      }

      function disableDetails() {
        detailsEnabled = false;
        pickerBtn?.setAttribute("aria-pressed", "false");
        pickerBtn?.classList.remove("active");
        if (statusText) statusText.textContent = "disabled";
        lcdScreen?.classList.remove("powered-on");
        badges.forEach((b) => b.classList.remove("inspect-mode"));
        renderPagerScreen(`
          <div class="pager-box-standby">
            <div class="pager-box-status">&#9632; [88x31 details disabled]</div>
          </div>
        `);
      }

      function enableDetails() {
        detailsEnabled = true;
        pickerBtn?.setAttribute("aria-pressed", "true");
        pickerBtn?.classList.add("active");
        if (statusText) statusText.textContent = "enabled";
        lcdScreen?.classList.add("powered-on");
        badges.forEach((b) => b.classList.add("inspect-mode"));
        renderPagerScreen(`
          <div class="pager-box-ready">
            <div class="pager-box-status">&#9679; [PICKER ACTIVE]</div>
            <div class="pager-box-sub">Click any 88x31 badge to inspect.</div>
          </div>
        `);
      }

      pickerBtn?.addEventListener("click", () => {
        if (detailsEnabled) {
          disableDetails();
        } else {
          enableDetails();
        }
      });

      badges.forEach((badge) => {
        badge.addEventListener("click", (e) => {
          if (!detailsEnabled) {
            // Let normal link navigation happen if url exists
            return;
          }

          // In inspector mode, intercept navigation & display text on single green screen
          e.preventDefault();
          const title = badge.getAttribute("data-title") || "Badge";
          const type = badge.getAttribute("data-type") || "community";
          const desc = badge.getAttribute("data-desc") || "88x31 button";
          const imgSrc =
            badge.getAttribute("data-img-src") ||
            badge.querySelector("img")?.src ||
            "";

          renderPagerScreen(`
            <div class="pager-box-detail">
              <div class="pager-badge-header">
                <img src="${imgSrc}" alt="${title}" class="pager-badge-preview" width="88" height="31" />
              </div>
              <div class="pager-info-list">
                <div class="pager-title-row">
                  <span class="pager-topic-tag">[${type}]</span>
                  <strong class="pager-title-text">${title}</strong>
                </div>
                <p class="pager-desc-text">${desc}</p>
              </div>
            </div>
          `);
        });
      });
    </script>
  </body>
</html>
