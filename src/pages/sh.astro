const links = [
  {
    title: "Portfolio",
    sub: "main hub",
    url: "/",
    desc: "The hotline."
  },
  {
    title: "Projects",
    sub: "coding",
    url: "/projects",
    desc: "Improving day by day."
  },
  {
    title: "Bookshelf",
    sub: "reviews",
    url: "/bookshelf",
    desc: "Literary reviews, what I'm reading now and more."
  },
  {
    title: "Progress",
    sub: "academics",
    url: "/progress",
    desc: "Master's in Computer Engineering & BS Computer Science transcripts."
  },
  {
    title: "Blog",
    sub: "articles",
    url: "/blog",
    desc: "My very own personal unbiased thoughts."
  },
  {
    title: "About",
    sub: "deep dive",
    url: "/about@sh",
    desc: "My background, what I use, etc."
  }
];

// Optional website links for specific badges (matched by filename without extension)
const badgeLinks: Record<string, string> = {
  astro: "https://astro.build/",
  eighty: "https://eightyeightthirty.one",
  rust: "https://rust-lang.org/",
  godot: "https://godotengine.org",
  linux: "https://www.kernel.org",
  neocities: "https://neocities.org",
  poweredbyfedora: "https://fedoraproject.org",
  steam: "https://store.steampowered.com",
};

// Automatically load all badges from src/assets/badges/
const badgeFiles = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/badges/*.{png,gif,jpg,jpeg,svg,webp,avif}",
  { eager: true }
);

const badges = Object.entries(badgeFiles).map(([path, mod]) => {
  const filename = path.split("/").pop()?.replace(/\.[^/.]+$/, "") || "badge";
  return {
    image: mod.default,
    name: filename,
    url: badgeLinks[filename] || null,
  };
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="magi / sh" />
    <title>magi / sh</title>
    <link rel="icon" type="image/svg+xml" href="/icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inconsolata:wght@300;400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      const savedTheme = typeof localStorage !== "undefined" && localStorage.getItem("theme");
      if (savedTheme === "dark" || (!savedTheme && window.matchMedia("(prefers-color-scheme: dark)").matches)) {
        document.documentElement.classList.add("dark");
      } else {
        document.documentElement.classList.remove("dark");
      }
    </script>
  </head>
  <body>
    <!-- Top Minimal Header -->
    <header class="sh-header">
      <div class="header-inner">
        <a href="/" class="back-link">
          &larr; to the hotline
        </a>
        <ThemeIcon />
      </div>
    </header>

    <!-- Main Container -->
    <main class="sh-container">
      <!-- Title section with Social Icons -->
      <section class="title-section">
        <h1 class="main-title">magi</h1>
        <div class="social-icons">
          {socials.map((item) => (
            <a
              href={item.url}
              target={item.url.startsWith("http") ? "_blank" : undefined}
              rel="noopener noreferrer"
              class="social-icon-btn"
              title={item.name}
              aria-label={item.name}
            >
              <Fragment set:html={item.svg} />
            </a>
          ))}
        </div>
      </section>

      <!-- About text -->
      <section class="about-section">
        <p class="about-text">
          Hi! My name is Paolo Imbriani.
          I am a 22 year old student, programmer, writer, logic passionate from Italy. 🇮🇹 <br/><br/>
          I like to research and enjoy building and maintaining open source projects.
          <br/><br/>
          I use my free time in this world to do what I like most. Most of these things happen to be on the
          infamous internet. This is my own little space. You are welcome! Feel free to wonder.
          <br/><br/>
          If you want to contact me, I am mostly active on <a href="https://x.com/hotlinemagi">X</a>
          (even though I want to find an alternative) and on <a href="https://discord.com/users/magidoof">Discord</a>.
        </p>
      </section>

      <!-- Navigation List -->
      <section class="links-section">
        <ul class="sh-links-list">
          {links.map((item) => (
            <li>
              <a href={item.url} class="sh-link-title">{item.title}</a> &ndash; <span class="sh-link-desc">{item.desc}</span>
            </li>
          ))}
        </ul>
      </section>

      <!-- 88x31 Badge Matrix (Dynamically loaded from src/assets/badges/) -->
      {badges.length > 0 && (
        <section class="badge-matrix-section">
          <div class="section-tag">88x31 matrix</div>
          <div class="matrix-grid">
            {badges.map((b) =>
              b.url ? (
                <a
                  href={b.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="badge-link badge-clickable"
                  title={`${b.name} (${b.url})`}
                >
                  <Image
                    src={b.image}
                    alt={b.name}
                    width={88}
                    height={31}
                    class="badge-img"
                    loading="lazy"
                  />
                </a>
              ) : (
                <div class="badge-link" title={b.name}>
                  <Image
                    src={b.image}
                    alt={b.name}
                    width={88}
                    height={31}
                    class="badge-img"
                    loading="lazy"
                  />
                </div>
              )
            )}
          </div>
        </section>
      )}

      <!-- Minimal footer -->
      <footer class="sh-footer">
        <span>magi &copy; 2026</span>
        <span>&bull;</span>
        <a href="/">return to main hotline</a>
      </footer>
    </main>
  </body>
</html>
