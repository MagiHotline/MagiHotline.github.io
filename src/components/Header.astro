---
import { Image } from "astro:assets";
import MyImage from "../assets/me.png";
---

<header class="top">
    <section class="main">
        <div class="container">
            <div class="info">
                <h1 class="text-3xl font-bold">Paolo Imbriani</h1>
                <h2 class="header">
                    Computer Science Student @ UNIVR, Aspiring Researcher
                </h2>
                <span class="header">
                    Mantova, Lombardia, Italy
                </span>
                <footer class="header">
                    <a
                        href="/Curriculum EN.pdf"
                        download
                        title="Download Curriculum Vitae"
                        class="cv-button"
                    >
                        Download CV
                    </a>
                    <a
                        href="mailto:paolo.imbriani@studenti.univr.it"
                        title="Email Paolo Imbriani"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="header"
                    >
                       Email
                    </a>
                    <a
                        href="https://www.instagram.com/magidoof77/"
                        title="Instagram"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="header"
                    >
                        Instagram
                    </a>
                    <a
                        href="https://www.linkedin.com/in/paolo-imbriani-ba1b7b215/"
                        title="Linkedin Paolo Imbriani"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="header"
                    >
                        Linkedin
                    </a>
                    <a
                        href="https://github.com/MagiHotline"
                        title="Github Paolo Imbriani"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="header"
                    >
                        Github
                    </a>
                </footer>
            </div>
            <div class="figure" style="margin-bottom: 8px;">
                <figure class="header">
                    <Image
                        src={MyImage}
                        alt="Imbriani Paolo"
                        width="200"
                        height="200"
                    />
                </figure>
            </div>
        </div>
    </section>
</header>

<style>
    .cv-button {
        display: inline-flex;
        align-items: center;
        background-color: #111;
        color: #fff;
        padding: 0.2rem 0.6rem;
        border-radius: 6px;
        font-weight: 600;
        font-size: 0.85rem;
        line-height: 1;
        text-decoration: none;
        transition: background-color 0.2s ease;
        margin-right: 4px;
        margin-top: 0;
    }
    .cv-button:hover {
        background-color: #4183c4;
        color: #fff;
    }
    :global(.dark) .cv-button {
        background-color: #fff;
        color: #111;
    }
    :global(.dark) .cv-button:hover {
        background-color: #8ab4f8;
        color: #111;
    }
</style>
