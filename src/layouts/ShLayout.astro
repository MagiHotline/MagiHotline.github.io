---
// src/layouts/ShLayout.astro
import "../styles/sh.css";
import ThemeIcon from "../components/ThemeIcon.astro";

interface Props {
  title?: string;
  description?: string;
  frontmatter?: {
    title?: string;
    description?: string;
  };
}

const { frontmatter, title, description } = Astro.props;

const pageTitle = frontmatter?.title || title || "about@sh";
const pageDesc = frontmatter?.description || description || "magi / sh about";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={pageDesc} />
    <title>{pageTitle}</title>
    <link rel="icon" type="image/svg+xml" href="/icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inconsolata:wght@300;400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      const savedTheme = typeof localStorage !== "undefined" && localStorage.getItem("theme");
      if (savedTheme === "dark" || (!savedTheme && window.matchMedia("(prefers-color-scheme: dark)").matches)) {
        document.documentElement.classList.add("dark");
      } else {
        document.documentElement.classList.remove("dark");
      }
    </script>
  </head>
  <body>
    <!-- Minimal Header with /sh and hotline navigation -->
    <header class="sh-header">
      <div class="header-inner sh-layout-nav">
        <a href="/sh" class="back-link">
          &larr; home
        </a>
        <div class="header-right-group">
          <a href="/" class="back-link hotline-link">
            to the hotline &rarr;
          </a>
          <ThemeIcon />
        </div>
      </div>
    </header>

    <!-- Main Container -->
    <main class="sh-container">
      <article class="sh-prose">
        <slot />
      </article>

      <!-- Minimal footer -->
      <footer class="sh-footer">
        <span>magi &copy; 2026</span>
        <span>&bull;</span>
        <a href="/sh">return to /sh</a>
        <span>&bull;</span>
        <a href="/">main hotline</a>
      </footer>
    </main>
  </body>
</html>

<style is:global>
  .sh-layout-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .header-right-group {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .hotline-link {
    color: var(--text-dim) !important;
    font-size: 0.85rem;
  }

  .hotline-link:hover {
    color: var(--text-main) !important;
  }

  /* Adaptive Markdown Styling */
  .sh-prose {
    color: var(--text-main);
    font-family:     "Inter",
    system-ui,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    Roboto,
    "Helvetica Neue",
    Arial,
    "Noto Sans",
    sans-serif,
    "Apple Color Emoji",
    "Segoe UI Emoji",
    "Segoe UI Symbol",
    "Noto Color Emoji";
    line-height: 1.7;
  }

  .sh-prose h1 {
    font-size: 2.2rem;
    font-weight: 800;
    color: var(--main-title);
    margin: 0.5rem 0 1.5rem 0;
    letter-spacing: -0.03em;
    border-bottom: 1px solid var(--border-subtle);
    padding-bottom: 0.6rem;
  }

  .sh-prose h2 {
    font-size: 1.45rem;
    font-weight: 700;
    color: var(--accent-emerald);
    margin: 2rem 0 0.8rem 0;
    letter-spacing: -0.01em;
    border-bottom: 1px solid var(--border-subtle);
    padding-bottom: 0.4rem;
  }

  .sh-prose h3 {
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--accent-green);
    margin: 1.4rem 0 0.4rem 0;
  }

  .sh-prose h4 {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--accent-teal);
    margin: 1.2rem 0 0.3rem 0;
  }

  .sh-prose p {
    font-size: 1.05rem;
    color: var(--text-main);
    margin: 0.8rem 0 1.2rem 0;
    line-height: 1.7;
  }

  .sh-prose a {
    color: var(--accent-emerald);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.15s ease;
  }

  .sh-prose a:hover {
    color: var(--text-main);
  }

  .sh-prose ul {
    list-style-type: disc !important;
    margin: 1rem 0 1.5rem 0;
    padding-left: 1.8rem !important;
  }

  .sh-prose ol {
    list-style-type: decimal !important;
    margin: 1rem 0 1.5rem 0;
    padding-left: 1.8rem !important;
  }

  .sh-prose ul ul {
    list-style-type: circle !important;
    margin: 0.4rem 0 0.4rem 0;
    padding-left: 1.5rem !important;
  }

  .sh-prose ol ol {
    list-style-type: lower-roman !important;
    margin: 0.4rem 0 0.4rem 0;
    padding-left: 1.5rem !important;
  }

  .sh-prose li {
    display: list-item !important;
    font-size: 1.05rem;
    margin-bottom: 0.45rem;
    line-height: 1.65;
    color: var(--text-main);
  }

  .sh-prose li::marker {
    color: var(--accent-emerald);
  }

  .sh-prose blockquote {
    border-left: 3px solid var(--accent-green);
    background-color: var(--card-bg);
    padding: 12px 16px;
    margin: 1.4rem 0;
    border-radius: 0 4px 4px 0;
    color: var(--text-muted);
    font-style: italic;
  }

  .sh-prose blockquote p {
    margin: 0;
    color: var(--text-muted);
  }

  .sh-prose code {
    background-color: var(--btn-bg);
    border: 1px solid var(--border-subtle);
    color: var(--accent-peach);
    font-family: "Inconsolata", monospace;
    font-size: 0.9em;
    padding: 2px 6px;
    border-radius: 4px;
  }

  .sh-prose pre {
    background-color: var(--card-bg) !important;
    border: 1px solid var(--border-subtle);
    border-radius: 6px;
    padding: 16px;
    margin: 1.4rem 0;
    overflow-x: auto;
  }

  .sh-prose pre code {
    background-color: transparent !important;
    border: none;
    padding: 0;
    color: var(--text-main);
    font-size: 0.95rem;
  }

  .sh-prose hr {
    border: none;
    border-top: 1px solid var(--border-subtle);
    margin: 2rem 0;
  }

  .sh-prose table {
    width: 100%;
    border-collapse: collapse;
    margin: 1.4rem 0;
    font-size: 0.95rem;
  }

  .sh-prose th,
  .sh-prose td {
    border: 1px solid var(--border-subtle);
    padding: 8px 12px;
    text-align: left;
  }

  .sh-prose th {
    background-color: var(--card-bg);
    color: var(--accent-green);
    font-weight: 700;
  }

  .sh-prose tr:nth-child(even) td {
    background-color: var(--table-even-bg);
  }
</style>
